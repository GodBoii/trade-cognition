# ---------------------------------------------------------------------------
# Trade Cognition - environment configuration
#
# Copy to .env and fill in real values.  Never commit .env.
#
# Two groups live here because the repository holds both halves of the system:
#   NEXT_PUBLIC_* browser bundle (baked in - never put a secret here)
#   TC_*    Python backend (read at startup by app/config.py)
# ---------------------------------------------------------------------------


# ===========================================================================
# FRONTEND (build time)
# ===========================================================================

# Supabase Auth browser configuration. The anon/publishable key is designed to
# be public; authorization is enforced by Supabase Auth and RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# The new browser flow talks to Supabase directly. No public backend URL is
# required on Vercel. These legacy values are only for old local API screens
# during the migration and should remain unset in the Vercel project.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# API_PROXY_TARGET=http://127.0.0.1:8000


# ===========================================================================
# BACKEND
# ===========================================================================

# --- Application -----------------------------------------------------------
TC_APP_NAME="Trade Cognition"
TC_ENV=development                 # development | staging | production
TC_LOG_LEVEL=INFO
TC_API_PREFIX=/api

# --- HTTP / CORS -----------------------------------------------------------
# Comma separated list of allowed browser origins for the SPA.  Add your
# deployed frontend origin here, e.g. https://trade-cognition.vercel.app
TC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# SQLite by default.  For production use PostgreSQL, e.g.
#   TC_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tradecognition
TC_DATABASE_URL=sqlite:///./data/trade_cognition.db

# --- Supabase Auth ---------------------------------------------------------
TC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Successful remote token validations are cached briefly in the API process.
TC_SUPABASE_AUTH_CACHE_SECONDS=30

# --- Asynchronous Supabase worker -----------------------------------------
# Opt in only after running supabase/002_async_trade_queue.sql. Create a
# scoped worker in the website's Accounts screen and paste its one-time token
# into the LOCAL worker .env. Never put TC_WORKER_TOKEN in Vercel or Git.
TC_SUPABASE_QUEUE_ENABLED=false
TC_WORKER_TOKEN=
TC_WORKER_POLL_INTERVAL_SECONDS=2.0
TC_WORKER_HEARTBEAT_INTERVAL_SECONDS=15.0
TC_WORKER_CLAIM_LEASE_SECONDS=90
# Keep this at 1: the current MT5 runtime serializes terminal operations.
TC_WORKER_BATCH_SIZE=1
TC_WORKER_BACKOFF_MAX_SECONDS=60.0

# --- Security --------------------------------------------------------------
# 1) JWT signing secret. Generate with:
#      python -c "import secrets;print(secrets.token_urlsafe(64))"
TC_JWT_SECRET=CHANGE_ME_generate_a_long_random_value
TC_JWT_ALGORITHM=HS256
TC_ACCESS_TOKEN_TTL_MINUTES=720

# 2) Fernet key used to encrypt stored MT5 passwords at rest. Generate with:
#      python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TC_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Legacy local auth is only used in tests/offline development when Supabase is
# not configured. Supabase controls production signup policy.
TC_ALLOW_REGISTRATION=false

# --- MT5 gateway -----------------------------------------------------------
# real -> uses the MetaTrader5 python package and a locally installed terminal
#         (64-bit Windows only, terminal must be running with Algo Trading on)
# mock -> deterministic in-process simulator (development, CI, demos)
TC_MT5_GATEWAY=mock
# Absolute path to terminal64.exe. Leave blank to let MT5 auto-detect.
TC_MT5_TERMINAL_PATH=
TC_MT5_TIMEOUT_MS=60000
# Serialised gateway calls: how long a call may wait for the MT5 worker thread.
TC_MT5_CALL_TIMEOUT_SECONDS=30
# Deviation (slippage) allowed on market orders, in points.
TC_MT5_DEVIATION_POINTS=20
# Magic number stamped on every order this platform sends.
TC_MT5_MAGIC=770425

# --- Position monitor ------------------------------------------------------
TC_MONITOR_ENABLED=true
TC_MONITOR_INTERVAL_SECONDS=2.0
# Broadcast interval for the /api/ws/stream websocket.
TC_STREAM_INTERVAL_SECONDS=2.0

# --- Risk defaults (used to seed a new user's risk profile) -----------------
TC_DEFAULT_LOTS_PER_1000=0.02
TC_DEFAULT_MAX_RISK_PCT=2.0
TC_DEFAULT_CAPITAL_BASIS=balance   # balance | equity | fixed
TC_DEFAULT_LADDER=runner_1_2_3     # runner keeps 25% for TP3; standard exits by TP2
